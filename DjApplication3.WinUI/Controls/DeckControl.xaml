<UserControl
    x:Class="DjApplication3.WinUI.Controls.DeckControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DjApplication3.WinUI.Controls">
    <Border CornerRadius="8" Background="#24282C" BorderBrush="#3A4148" BorderThickness="1" Padding="12" Margin="0,0,0,10" MinHeight="300" Height="{Binding DeckHeight}">
        <Border.Resources>
            <Style x:Key="DeckActionButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="MinWidth" Value="68" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="DeckToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="MinWidth" Value="118" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </Border.Resources>
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="92" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="84" />
                <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" Foreground="#F6F7F8" FontSize="16" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Bpm}" Foreground="#E9FF70" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding TrackNumber}" Foreground="#F6F7F8" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ToggleSwitch
                    Grid.Column="3"
                    Header="Auto"
                    IsOn="{Binding IsAutoNext, Mode=TwoWay}"
                    MinWidth="124"
                    MinHeight="40"
                    ToolTipService.ToolTip="{Binding NextMusicPreview}" />
            </Grid>

            <controls:WaveformControl
                Grid.Row="1"
                Waveform="{Binding Waveform}"
                Position="{Binding PositionRatio}"
                EndWarningActive="{Binding IsEndingSoon}"
                SeekRequested="Waveform_SeekRequested" />

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CurrentTime}" Foreground="#BCC5CE" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding TotalTime}" Foreground="#BCC5CE" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding RemainingTime}" Foreground="#FFB4A8" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="124" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PlayPauseButton"
                    Content="{Binding PlayStateLabel}"
                    Click="PlayPauseButton_Click"
                    Style="{StaticResource DeckActionButtonStyle}"
                    Background="{Binding PlayButtonBackground}"
                    Foreground="{Binding PlayButtonForeground}" />
                <Button Grid.Column="1" Content="Stop" Click="StopButton_Click" Style="{StaticResource DeckActionButtonStyle}" />
                <controls:TrackBarPerso
                    Grid.Column="2"
                    Minimum="0"
                    Maximum="100"
                    Default="100"
                    Value="{Binding Volume, Mode=TwoWay}"
                    AnimationStep="1"
                    AnimationIntervalMs="10" />
                <ToggleButton Grid.Column="3" Content="{Binding HeadphoneLabel}" IsChecked="{Binding IsHeadphone, Mode=TwoWay}" Style="{StaticResource DeckToggleButtonStyle}" />
                <Button
                    Grid.Column="4"
                    Content="Rnd"
                    Click="RandomButton_Click"
                    Style="{StaticResource DeckActionButtonStyle}"
                    ToolTipService.ToolTip="{Binding NextMusicPreview}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
