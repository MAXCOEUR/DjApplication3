<UserControl
    x:Class="DjApplication3.WinUI.Controls.TrackBarPerso"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="36">

    <Grid
        x:Name="Root"
        Background="Transparent"
        SizeChanged="Root_SizeChanged"
        PointerPressed="Root_PointerPressed"
        PointerMoved="Root_PointerMoved"
        PointerReleased="Root_PointerReleased"
        PointerExited="Root_PointerExited">

        <Border
            x:Name="BackgroundBar"
            Height="18"
            VerticalAlignment="Center"
            CornerRadius="9"
            Background="#30343A"
            BorderBrush="#4B535C"
            BorderThickness="1" />

        <Rectangle
            x:Name="CenterLineVertical"
            Width="2"
            Fill="#E6FFFFFF"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Margin="0,6" />

        <Rectangle
            x:Name="CenterLineHorizontal"
            Height="2"
            Fill="#E6FFFFFF"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Margin="6,0"
            Visibility="Collapsed" />

        <Border
            x:Name="Thumb"
            Width="24"
            Height="34"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            CornerRadius="5"
            Background="#FFFF3FC7"
            BorderBrush="#FFFFFFFF"
            BorderThickness="1"
            PointerPressed="Thumb_PointerPressed"
            PointerReleased="Thumb_PointerReleased">

            <Border.RenderTransform>
                <TranslateTransform x:Name="ThumbTransform" />
            </Border.RenderTransform>

            <Grid>
                <Rectangle
                    x:Name="ThumbGripVertical"
                    Width="2"
                    Fill="#FFFFFFFF"
                    HorizontalAlignment="Center"
                    Margin="0,5" />

                <Rectangle
                    x:Name="ThumbGripHorizontal"
                    Height="2"
                    Fill="#FFFFFFFF"
                    VerticalAlignment="Center"
                    Margin="5,0"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
