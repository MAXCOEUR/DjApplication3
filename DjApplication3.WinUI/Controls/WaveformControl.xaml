<UserControl
    x:Class="DjApplication3.WinUI.Controls.WaveformControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="Root"
        Background="#202427"
        PointerPressed="Root_PointerPressed"
        SizeChanged="Root_SizeChanged">

        <Image
            x:Name="WaveImage"
            Stretch="Fill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <Rectangle
            x:Name="PositionMarker"
            Width="4"
            Fill="#FF00E5FF"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="PositionMarkerTransform" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <Grid
            x:Name="LoadingOverlay"
            Background="#66000000"
            Visibility="Collapsed"
            IsHitTestVisible="False">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">

                <ProgressRing
                    Width="32"
                    Height="32"
                    IsActive="True" />

                <TextBlock
                    Text="Calcul waveform..."
                    Foreground="#F6F7F8"
                    FontSize="12"
                    HorizontalAlignment="Center" />

            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
