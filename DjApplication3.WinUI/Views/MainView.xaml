<UserControl
    x:Class="DjApplication3.WinUI.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DjApplication3.WinUI.Controls"
    xmlns:vm="using:DjApplication3.WinUI.ViewModels">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid Background="#171A1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <Grid Padding="6" Background="#202427" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="86" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="DjApplication 3" Foreground="#F6F7F8" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />

            <ComboBox Grid.Column="1" x:Name="TrackCountCombo" SelectionChanged="TrackCountCombo_SelectionChanged" VerticalAlignment="Center" MinHeight="34">
                <ComboBoxItem Content="2" IsSelected="True" />
                <ComboBoxItem Content="3" />
                <ComboBoxItem Content="4" />
            </ComboBox>

            <Grid Grid.Column="2" RowSpacing="3" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="18" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding PreviewTitle}"
                        Foreground="#F6F7F8"
                        FontSize="12"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding PreviewBpmText}"
                        Foreground="#E9FF70"
                        FontSize="12"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        TextAlignment="Right" />
                    <TextBlock
                        Grid.Column="2"
                        Text="{Binding DeckBpmSummary}"
                        Foreground="#BCC5CE"
                        FontSize="12"
                        VerticalAlignment="Center"
                        TextAlignment="Right"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Content="{Binding PreviewPlayPauseText}"
                        Click="PreviewPlayPauseButton_Click"
                        IsEnabled="{Binding IsPreviewActive}"
                        Background="{Binding PreviewPlayPauseBackground}"
                        Foreground="{Binding PreviewPlayPauseForeground}"
                        MinHeight="28"
                        Padding="6,0" />

                    <Button
                        Grid.Column="1"
                        Content="Stop"
                        Click="PreviewStopButton_Click"
                        IsEnabled="{Binding IsPreviewActive}"
                        MinHeight="28"
                        Padding="6,0" />

                    <controls:WaveformControl
                        Grid.Column="2"
                        Waveform="{Binding PreviewWaveform}"
                        Position="{Binding PreviewWavePosition}"
                        WaveformBackground="#101820"
                        IsEnabled="{Binding IsPreviewActive}"
                        SeekRequested="PreviewWaveform_SeekRequested"
                        Height="30"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="3"
                        Text="{Binding PreviewTimeText}"
                        Foreground="#BCC5CE"
                        FontSize="12"
                        TextAlignment="Right"
                        VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Grid Grid.Column="3" ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Casque"
                    Foreground="#BCC5CE"
                    VerticalAlignment="Center" />

                            <controls:TrackBarPerso
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="100"
                    Default="100"
                            BarHeight="24"
                    Value="{Binding HeadphoneVolume, Mode=TwoWay}"
                    AnimationStep="1"
                    AnimationIntervalMs="10" />
            </Grid>
                        <Button Grid.Column="4" Content="Option" Click="SettingsButton_Click" MinHeight="34" MinWidth="72" FontWeight="SemiBold" />
        </Grid>

        <Grid x:Name="MainContentGrid" Grid.Row="1" Padding="14" ColumnSpacing="14" SizeChanged="MainContentGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DeckAreaColumn" Width="2.2*" />
                <ColumnDefinition x:Name="MainResizeColumn" Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#24282C" BorderBrush="#3A4148" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Gauche"
                            Foreground="#BCC5CE"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0" />

                        <ComboBox
                            Grid.Column="1"
                            ItemsSource="{Binding TrackNumbers}"
                            SelectedItem="{Binding LeftDeckNumber, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            MinHeight="34" />

                        <controls:TrackBarPerso
                            Grid.Column="2"
                            Minimum="0"
                            Maximum="100"
                            Default="50"
                            BarHeight="24"
                            Value="{Binding Crossfade, Mode=TwoWay}"
                            AnimationStep="1"
                            AnimationIntervalMs="10"
                            VerticalAlignment="Center" />

                        <ComboBox
                            Grid.Column="3"
                            ItemsSource="{Binding TrackNumbers}"
                            SelectedItem="{Binding RightDeckNumber, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            MinHeight="34" />

                        <TextBlock
                            Grid.Column="4"
                            Text="Droite"
                            Foreground="#BCC5CE"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0" />
                    </Grid>
                </Border>

                <ScrollViewer
                    x:Name="DeckScrollViewer"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    SizeChanged="DeckScrollViewer_SizeChanged">

                    <ItemsRepeater ItemsSource="{Binding Decks}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <controls:DeckControl DataContext="{Binding}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </ScrollViewer>
            </Grid>

            <Border
                x:Name="MainResizeGrip"
                Grid.Column="1"
                Background="#3A4148"
                CornerRadius="3"
                PointerPressed="MainResizeGrip_PointerPressed"
                PointerMoved="MainResizeGrip_PointerMoved"
                PointerReleased="MainResizeGrip_PointerReleased"
                PointerCanceled="MainResizeGrip_PointerCanceled" />

            <Grid
                x:Name="LibraryPanel"
                Grid.Column="2"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SourceCombo" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" ItemsSource="{Binding Sources}" />
                    <TextBox
                        Grid.Column="1"
                        PlaceholderText="Recherche"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        KeyUp="SearchBox_KeyUp" />
                    <Button
                        x:Name="SearchButton"
                        Grid.Column="2"
                        Content="Go"
                        Click="SearchButton_Click"
                        MinHeight="36" />

                    <Button
                        x:Name="RefreshButton"
                        Grid.Column="3"
                        Content="Reload"
                        Click="RefreshButton_Click"
                        MinHeight="36" />
                </Grid>

                <Grid x:Name="LocalRootPanel" Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Dossier" Click="BrowseFolderButton_Click" MinHeight="38" />
                    <Border
                        Grid.Column="1"
                        Background="#25292E"
                        BorderBrush="#353C44"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12,0"
                        MinHeight="38">
                        <TextBlock
                            Text="{Binding LocalPathDisplay}"
                            Foreground="#F6F7F8"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Border
                    x:Name="PlaylistTitlePanel"
                    Grid.Row="1"
                    Background="#25292E"
                    BorderBrush="#353C44"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12,0"
                    MinHeight="38"
                    Visibility="Collapsed">
                    <TextBlock
                        Text="{Binding CurrentPlaylistDisplay}"
                        Foreground="#F6F7F8"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </Border>

                <Grid x:Name="LibraryListsGrid" Grid.Row="2" ColumnSpacing="6" SizeChanged="LibraryListsGrid_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NavigationColumn" Width="190" />
                        <ColumnDefinition x:Name="NavigationResizeColumn" Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="LocalFolderPanel" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding FolderHeaderLabel}" Foreground="#BCC5CE" FontWeight="SemiBold" />
                        <ListView
    Grid.Row="1"
    x:Name="FolderList"
    ItemsSource="{Binding LocalFolders}"
    DoubleTapped="FolderList_DoubleTapped"
    SelectionMode="Single"
    SelectionChanged="FolderList_SelectionChanged">

                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#30404E" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#3A4C5E" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#293542" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFF" />
                            </ListView.Resources>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        MinHeight="38"
                                        Padding="8,0"
                                        Background="Transparent">
                                        <TextBlock
                                            Text="{Binding Name}"
                                            Foreground="#F6F7F8"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid x:Name="PlaylistPanel" RowSpacing="6" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding PlaylistHeaderLabel}" Foreground="#BCC5CE" FontWeight="SemiBold" />
                        <ListView
                            Grid.Row="1"
                            x:Name="PlaylistList"
                            ItemsSource="{Binding Playlists}"
                            DoubleTapped="PlaylistList_DoubleTapped"
                            SelectionMode="Single"
                            SelectionChanged="PlaylistList_SelectionChanged">

                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#30404E" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#3A4C5E" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#293542" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFF" />
                            </ListView.Resources>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        MinHeight="38"
                                        Padding="8,0"
                                        Background="Transparent">
                                        <TextBlock
                                            Text="{Binding Name}"
                                            Foreground="#F6F7F8"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Border
                        x:Name="LibraryResizeGrip"
                        Grid.Column="1"
                        Background="#3A4148"
                        CornerRadius="3"
                        PointerPressed="LibraryResizeGrip_PointerPressed"
                        PointerMoved="LibraryResizeGrip_PointerMoved"
                        PointerReleased="LibraryResizeGrip_PointerReleased"
                        PointerCanceled="LibraryResizeGrip_PointerCanceled" />

                    <Grid Grid.Column="2" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBlock Text="{Binding MusicHeaderLabel}" Foreground="#BCC5CE" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel
                                    x:Name="MusicLoadingPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                    <ProgressRing
                                        x:Name="MusicLoadingRing"
                                        Width="16"
                                        Height="16"
                                        IsActive="False" />
                                    <TextBlock
                                        x:Name="MusicLoadingText"
                                        Text="Chargement..."
                                        Foreground="#BCC5CE"
                                        FontSize="12" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="Cue" Foreground="#BCC5CE" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="DL" Foreground="#BCC5CE" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="BPM" Foreground="#BCC5CE" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Grid>

                        <ListView
                            Grid.Row="1"
                            x:Name="MusicList"
                            ItemsSource="{Binding Musics}"
                            DoubleTapped="MusicList_DoubleTapped"
                            SelectionMode="Single"
                            SelectionChanged="MusicList_SelectionChanged">

                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#26313A" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#26313A" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#26313A" />
                                <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFF" />
                            </ListView.Resources>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="2" />
                                    <Setter Property="Margin" Value="0,2" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        MinHeight="48"
                                        ColumnSpacing="8"
                                        Background="{Binding RowBackground}"
                                        RightTapped="MusicRow_RightTapped"
                                        Padding="4,2">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                Text="{Binding Title}"
                                                Foreground="#F6F7F8"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Text="{Binding Author}"
                                                Foreground="#8E9AA6"
                                                FontSize="12"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            Content="{Binding PreviewText}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MinWidth="42"
                                            MinHeight="30"
                                            Padding="4,0"
                                            Background="{Binding PreviewButtonBackground}"
                                            Foreground="{Binding PreviewButtonForeground}"
                                            Click="PreviewButton_Click"
                                            ToolTipService.ToolTip="Pre-ecoute casque" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding DownloadText}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="#E9FF70"
                                            FontWeight="SemiBold" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding BpmText}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="#F6F7F8" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="#BCC5CE" Padding="14,2" />

        <Border x:Name="SettingsOverlay" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Grid Width="620" HorizontalAlignment="Right" Background="#202427" Padding="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Paramètres" FontSize="22" FontWeight="SemiBold" />
                    <Button Content="Fermer" HorizontalAlignment="Right" Click="CloseSettingsButton_Click" />
                </Grid>
                <StackPanel Grid.Row="1" Spacing="16" Margin="0,20,0,0">
                    <TextBlock Text="Sortie audio standard" />
                    <ComboBox x:Name="AudioOutputCombo" SelectionChanged="AudioOutputCombo_SelectionChanged" />
                    <TextBlock Text="Sortie audio casque" />
                    <ComboBox x:Name="HeadphoneOutputCombo" SelectionChanged="HeadphoneOutputCombo_SelectionChanged" />
                    <TextBlock Text="Appareil MIDI" />
                    <ComboBox x:Name="MidiCombo" SelectionChanged="MidiCombo_SelectionChanged" />
                    <Button
                        x:Name="ResetPlayedMusicButton"
                        Content="Reset musiques lues"
                        Click="ResetPlayedMusicButton_Click" />
                    <Button x:Name="YtMusicButton" Content="Connexion Youtube Music" Click="YtMusicButton_Click" />
                    <Grid x:Name="LoginPanel" Visibility="Collapsed" Height="420">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="LoginWebViewHost" />
                        <Button Grid.Row="1" Content="Continuer après connexion" Click="ContinueYtMusicButton_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
