<UserControl
    x:Class="DjApplication3.WinUI.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DjApplication3.WinUI.Controls"
    xmlns:vm="using:DjApplication3.WinUI.ViewModels">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid Background="#171A1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Padding="14,8" Background="#202427" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="86" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="DjApplication 3" Foreground="#F6F7F8" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="TrackCountCombo" SelectionChanged="TrackCountCombo_SelectionChanged" VerticalAlignment="Center">
                <ComboBoxItem Content="2" IsSelected="True" />
                <ComboBoxItem Content="3" />
                <ComboBoxItem Content="4" />
            </ComboBox>
            <Grid Grid.Column="2" ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Casque"
                    Foreground="#BCC5CE"
                    VerticalAlignment="Center" />

                            <controls:TrackBarPerso
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="100"
                    Default="100"
                    Value="{Binding HeadphoneVolume, Mode=TwoWay}"
                    AnimationStep="1"
                    AnimationIntervalMs="10" />
            </Grid>
            <Button Grid.Column="3" Content="Option" Click="SettingsButton_Click" MinHeight="40" MinWidth="78" FontWeight="SemiBold" />
        </Grid>

        <Grid Grid.Row="1" Padding="14" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#24282C" BorderBrush="#3A4148" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="116" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Gauche" Foreground="#BCC5CE" FontSize="11" />
                            <ComboBox ItemsSource="{Binding TrackNumbers}" SelectedItem="{Binding LeftDeckNumber, Mode=TwoWay}" HorizontalAlignment="Stretch" MinHeight="42" />
                        </StackPanel>
                        <controls:TrackBarPerso
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="100"
                            Default="50"
                            Value="{Binding Crossfade, Mode=TwoWay}"
                            AnimationStep="1"
                            AnimationIntervalMs="10"
                            VerticalAlignment="Center"
                            MinHeight="42" />
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Droite" Foreground="#BCC5CE" FontSize="11" />
                            <ComboBox ItemsSource="{Binding TrackNumbers}" SelectedItem="{Binding RightDeckNumber, Mode=TwoWay}" HorizontalAlignment="Stretch" MinHeight="42" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer
                    x:Name="DeckScrollViewer"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    SizeChanged="DeckScrollViewer_SizeChanged">

                    <ItemsRepeater ItemsSource="{Binding Decks}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <controls:DeckControl DataContext="{Binding}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </ScrollViewer>
            </Grid>

            <Border Grid.Column="1" Background="#3A4148" />

            <Grid Grid.Column="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SourceCombo" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" ItemsSource="{Binding Sources}" />
                    <TextBox Grid.Column="1" PlaceholderText="Recherche" Text="{Binding SearchText, Mode=TwoWay}" KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="2" Content="Go" Click="SearchButton_Click" MinHeight="36" />
                    <Button Grid.Column="3" Content="Reload" Click="RefreshButton_Click" MinHeight="36" />
                </Grid>

                <Grid x:Name="LocalRootPanel" Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Dossier" Click="BrowseFolderButton_Click" MinHeight="38" />
                    <TextBox Grid.Column="1" PlaceholderText="Dossier local" Text="{Binding LocalFolderPath, Mode=TwoWay}" KeyDown="LocalFolderBox_KeyDown" />
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NavigationColumn" Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="LocalFolderPanel" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Dossiers" Foreground="#BCC5CE" FontWeight="SemiBold" />
                        <ListView Grid.Row="1" x:Name="FolderList" ItemsSource="{Binding LocalFolders}" DoubleTapped="FolderList_DoubleTapped" SelectionMode="Single" SelectionChanged="FolderList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MinHeight="34" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid x:Name="PlaylistPanel" RowSpacing="6" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Playlists Youtube Music" Foreground="#BCC5CE" FontWeight="SemiBold" />
                        <ListView Grid.Row="1" x:Name="PlaylistList" ItemsSource="{Binding Playlists}" DoubleTapped="PlaylistList_DoubleTapped" SelectionMode="Single" SelectionChanged="PlaylistList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding name}" TextTrimming="CharacterEllipsis" MinHeight="34" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Titre" Foreground="#BCC5CE" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="DL" Foreground="#BCC5CE" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="BPM" Foreground="#BCC5CE" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Grid>

                        <ListView Grid.Row="1" x:Name="MusicList" ItemsSource="{Binding Musics}" DoubleTapped="MusicList_DoubleTapped" SelectionMode="Single" SelectionChanged="MusicList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="48" ColumnSpacing="8" Background="{Binding RowBackground}" RightTapped="MusicRow_RightTapped" Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#F6F7F8" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Author}" Foreground="#8E9AA6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DownloadText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E9FF70" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding BpmText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="#BCC5CE" Padding="14,4" />

        <Border x:Name="SettingsOverlay" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <Grid Width="620" HorizontalAlignment="Right" Background="#202427" Padding="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Paramètres" FontSize="22" FontWeight="SemiBold" />
                    <Button Content="Fermer" HorizontalAlignment="Right" Click="CloseSettingsButton_Click" />
                </Grid>
                <StackPanel Grid.Row="1" Spacing="16" Margin="0,20,0,0">
                    <TextBlock Text="Sortie audio standard" />
                    <ComboBox x:Name="AudioOutputCombo" SelectionChanged="AudioOutputCombo_SelectionChanged" />
                    <TextBlock Text="Sortie audio casque" />
                    <ComboBox x:Name="HeadphoneOutputCombo" SelectionChanged="HeadphoneOutputCombo_SelectionChanged" />
                    <TextBlock Text="Appareil MIDI" />
                    <ComboBox x:Name="MidiCombo" SelectionChanged="MidiCombo_SelectionChanged" />
                    <Button x:Name="YtMusicButton" Content="Connexion Youtube Music" Click="YtMusicButton_Click" />
                    <Grid x:Name="LoginPanel" Visibility="Collapsed" Height="420">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="LoginWebViewHost" />
                        <Button Grid.Row="1" Content="Continuer après connexion" Click="ContinueYtMusicButton_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
